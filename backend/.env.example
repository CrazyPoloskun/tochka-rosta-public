# ==============================================================================
# ПЕРЕМЕННЫЕ ОКРУЖЕНИЯ ДЛЯ BACKEND (FastAPI + SQLAlchemy)
# Скопируйте этот файл в backend/.env
# ==============================================================================

PROJECT_NAME="Tochka Rosta API"
API_V1_STR="/api/v1"
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:3001","https://83.141.68.181.sslip.io"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=tochka_rosta

# Async Database URL (used by SQLAlchemy + asyncpg)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# JWT Secret & Session expiration
SECRET_KEY="tochka-rosta-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# AI & LLM Integrations (Real Neural Network)
# Поддерживается любой из провайдеров (OpenRouter, OpenAI/DeepSeek, Google Gemini или встроенный Neural Gateway)
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"
OPENAI_BASE_URL="https://api.openai.com/v1"

GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# External Integrations (Опционально)
DADATA_API_KEY=""
UPLOAD_DIR="uploads"
