# --- База данных (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tochka_rosta

# --- Безопасность и токены (JWT) ---
SECRET_KEY=tochka-rosta-prod-secret-key-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Доступ и режим тестирования ---
BETA_MODE=true
BETA_CODE=tochka2026

# --- OpenRouter API ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- OpenAI API (резервный провайдер) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini API (резервный провайдер) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Локальный прокси для AI-запросов ---
OPENROUTER_PROXY=http://gluetun:8888
AI_PROXY=http://gluetun:8888

# --- Подключение WireGuard VPN (Gluetun) ---
WG_ENDPOINT_IP=
WG_ENDPOINT_PORT=51820
WG_PUBLIC_KEY=
WG_PRIVATE_KEY=
WG_PRESHARED_KEY=
WG_ADDRESSES=10.0.0.2/24
