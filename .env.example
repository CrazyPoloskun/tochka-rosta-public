# ==============================================================================
# ПОЛНЫЙ ПРИМЕР ПЕРЕМЕННЫХ ОКРУЖЕНИЯ ПЛАТФОРМЫ «ТОЧКА РОСТА» (.env.example)
# Скопируйте этот файл в .env (для Docker / Root) или в соответствующие подпапки.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. ОБЩИЕ ПАРАМЕТРЫ ПЛАТФОРМЫ
# ------------------------------------------------------------------------------
PROJECT_NAME="Tochka Rosta DeepTech Platform"
API_V1_STR="/api/v1"
DOMAIN_NAME=83.141.68.181.sslip.io

# ------------------------------------------------------------------------------
# 2. БАЗА ДАННЫХ POSTGRESQL (ASYNCPG + SQLALCHEMY 2.0)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=tochka_rosta

# Асинхронная строка подключения SQLAlchemy (asyncpg):
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 3. БЕЗОПАСНОСТЬ И JWT-АУТЕНТИФИКАЦИЯ
# ------------------------------------------------------------------------------
# Секретный ключ подписи JWT токенов (в продакшне сгенерируйте: openssl rand -hex 32)
SECRET_KEY="tochka-rosta-secure-jwt-secret-key-change-in-production"
ALGORITHM="HS256"

# Срок действия access token (в минутах, по умолчанию 1440 = 24 часа)
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Срок действия refresh token (в днях, по умолчанию 7 дней)
REFRESH_TOKEN_EXPIRE_DAYS=7

# ------------------------------------------------------------------------------
# 4. ИИ-ИНТЕГРАЦИЯ ЧЕРЕЗ OPENROUTER (LLM ДЛЯ ПАРСИНГА PDF, ТЗ И ОТЧЁТОВ)
# ------------------------------------------------------------------------------
# API-ключ OpenRouter (получите на https://openrouter.ai/keys)
# Если ключ пустой — платформа автоматически работает на встроенном офлайн-движке эвристик.
OPENROUTER_API_KEY=""

# Выбранная модель OpenRouter:
# Варианты:
# - google/gemini-2.5-flash        (рекомендуемая: быстрая, умная, дешёвая)
# - openai/gpt-4o-mini             (быстрая и точная альтернатива от OpenAI)
# - anthropic/claude-3.5-haiku     (отличная модель для анализа научно-технических текстов)
# - deepseek/deepseek-chat         (высокоточная экономичная модель)
OPENROUTER_MODEL="google/gemini-2.5-flash"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# ------------------------------------------------------------------------------
# 5. ВНЕШНИЕ СЕРВИСЫ И ПРОВЕРКА КОНТРАГЕНТОВ (ОПЦИОНАЛЬНО)
# ------------------------------------------------------------------------------
# API ключ DaData для расширенного автозаполнения реквизитов компаний по ИНН:
DADATA_API_KEY=""

# ------------------------------------------------------------------------------
# 6. ХРАНИЛИЩЕ ФАЙЛОВ И ДОКУМЕНТОВ
# ------------------------------------------------------------------------------
# Локальная папка для сохранения отчётов, сканов патентов и уставных документов
UPLOAD_DIR="uploads"

# ------------------------------------------------------------------------------
# 7. СЕТЬ, CORS И NGINX REVERSE PROXY
# ------------------------------------------------------------------------------
# Разрешенные CORS-адреса для браузерных запросов
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://83.141.68.181.sslip.io"]

# URL API для фронтенда:
# - "" (пустая строка) — если фронтенд и бэкенд работают за Nginx на одном домене/порту;
# - "http://localhost:8000" — для раздельного локального запуска Next.js и FastAPI.
NEXT_PUBLIC_API_URL=""

# ------------------------------------------------------------------------------
# 8. ЗАКРЫТЫЙ БЕТА-КОНТУР (SECURITY POINT)
# ------------------------------------------------------------------------------
# true — доступ к платформе блокируется экраном ввода PIN-кода
# false — платформа открыта для свободного доступа
BETA_MODE=true

# Секретный PIN-код для приглашенных тестировщиков:
BETA_CODE=tochka2026
