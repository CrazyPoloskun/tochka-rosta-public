# =====================================================================
# Production Environment Variables for Tochka Rosta
# Скопируйте этот файл в .env на сервере: cp .env.production.example .env
# =====================================================================

# PostgreSQL credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_super_strong_database_password
POSTGRES_DB=tochka_rosta

# Security (генерируйте случайную строку: openssl rand -hex 32)
SECRET_KEY=change_this_to_a_very_long_secure_random_key_in_production

# Режим закрытого бета-тестирования (SECURITY POINT)
# true — включить защиту (экран блокировки), false — отключить (открытый доступ)
BETA_MODE=true
# Секретный код тестировщика
BETA_CODE=tochka2026

# Domain name (если используется)
DOMAIN_NAME=yourdomain.ru
